---
import { getCollection } from 'astro:content';
import { lien } from '../config/lien';

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Carte from '../components/Carte.astro';
import Badge from '../components/Badge.astro';
import AppelAction from '../components/AppelAction.astro';
import { SITE } from '../config/site';

const systemes = (await getCollection('systemes')).sort(
  (a, b) => a.data.ordre - b.data.ordre
);

/** Les trois différenciateurs — brief §1. Ce sont des preuves, pas des adjectifs. */
const differenciateurs = [
  {
    titre: 'Vous pouvez justifier chaque décision',
    texte:
      "L'IA propose, un moteur de règles vérifie, un humain signe. Chaque étape est horodatée et attribuée — devant un client, un auditeur ou l'ordre.",
  },
  {
    titre: 'Rien n\'est livré sur parole',
    texte:
      'Le système est mesuré sur vos propres dossiers avant d\'être branché. Vous voyez un score sur des cas réels, pas une démonstration.',
  },
  {
    titre: 'Vos données ne sortent pas',
    texte:
      'Hébergement chez vous ou en Europe, chiffrement par client. Conforme RGPD, et compatible SYSCOHADA pour les cabinets qui travaillent sur les deux référentiels.',
  },
];

const methode = [
  {
    temps: 'Plan',
    texte:
      "Le périmètre se ferme avant d'écrire du code : critères d'acceptation testables et critères d'abandon écrits à l'avance.",
  },
  {
    temps: 'Build',
    texte:
      "L'architecture sépare ce que la machine propose de ce qu'un humain assume. La frontière est explicite, jamais implicite.",
  },
  {
    temps: 'Verify',
    texte:
      "Un harness d'évaluation en gate : rien ne passe sur un score déclaré, tout passe sur un corpus mesuré.",
  },
  {
    temps: 'Evolve',
    texte:
      'Toute évolution de périmètre passe par un decision log. Une règle qui change ne doit pas obliger à redéployer le moteur.',
  },
];
---

<Base titre={SITE.titre} description={SITE.description}>
  <!-- ══ Thèse ══ -->
  <Section class="pt-4">
    <p class="text-menu text-accent">Systèmes agentiques en environnement normé</p>

    <h1 class="mt-6 max-w-[20ch] text-h1">
      La plupart des pilotes IA ne passent jamais en production. Je construis ceux
      qui y arrivent — dans les métiers où une décision doit être justifiable.
    </h1>

    <p class="mt-8 max-w-texte text-secondaire">
      J'aide les organisations en environnement normé à passer du pilote IA au
      système agentique en production, avec une architecture où
      <strong class="text-texte">l'IA propose</strong>, un
      <strong class="text-texte">moteur déterministe contrôle</strong> et
      <strong class="text-texte">l'humain approuve</strong>.
    </p>

    <AppelAction variante="sobre" class="mt-10" />
  </Section>

  <!-- ══ Les trois preuves ══ -->
  <Section separee>
    <h2 class="text-h2">Ce qui change concrètement</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        differenciateurs.map((d, i) => (
          <Carte>
            <p class="font-titre text-menu text-secondaire">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-3 text-h3">{d.titre}</h3>
            <p class="mt-3 text-appui text-secondaire">{d.texte}</p>
          </Carte>
        ))
      }
    </div>
  </Section>

  <!-- ══ Les systèmes ══ -->
  <Section separee>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-h2">Systèmes construits</h2>
      <a
        href={lien('/systemes')}
        class="text-menu text-accent underline underline-offset-4"
      >
        Voir les quatre études de cas
      </a>
    </div>

    <p class="mt-4 max-w-texte text-secondaire">
      Chaque statut est affiché tel quel, y compris quand le système est encore
      en construction. Vous saurez toujours ce qui tourne et ce qui se bâtit.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        systemes.map((s) => (
          <Carte href={lien(`/systemes/${s.id}`)}>
            <Badge statut={s.data.statut} />
            <h3 class="mt-4 text-h3">{s.data.titre}</h3>
            <p class="mt-3 text-appui text-secondaire">{s.data.resume}</p>
            <p class="mt-4 text-menu text-secondaire">{s.data.domaine}</p>
          </Carte>
        ))
      }
    </div>
  </Section>

  <!-- ══ Méthode ══ -->
  <Section separee>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-h2">La méthode en quatre temps</h2>
      <a href={lien('/methode')} class="text-menu text-accent underline underline-offset-4">
        Le détail des gates
      </a>
    </div>

    <ol class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        methode.map((m, i) => (
          <li class="border-t border-trait pt-6">
            <p class="font-titre text-menu text-secondaire">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-2 text-h3 text-accent">{m.temps}</h3>
            <p class="mt-3 text-appui text-secondaire">{m.texte}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ══ Point d'entrée ══
       Une seule offre est nommée sur l'accueil, la moins engageante. Les trois
       vivent sur /offres ; en montrer trois ici, c'est demander un arbitrage
       avant d'avoir gagné la confiance. ══ -->
  <Section separee>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-h2">Par où ça commence</h2>
      <a href={lien('/offres')} class="text-menu text-accent underline underline-offset-4">
        Les trois offres
      </a>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-[1fr_1fr]">
      <div>
        <p class="font-titre text-menu text-secondaire">01</p>
        <h3 class="mt-3 text-h3">Audit Pilote → Production</h3>
        <p class="mt-2 text-menu text-secondaire">Forfait, 5 à 10 jours</p>
        <p class="mt-4 max-w-texte text-appui text-secondaire">
          Votre pilote fonctionne en démonstration et bloque avant la
          production. L'audit dit où il bloque, ce qu'il faut pour le débloquer,
          et dans quel ordre. Périmètre fermé, prix fixe, aucune suite obligée.
        </p>
      </div>

      <ul class="flex flex-col justify-center gap-3 border-t border-trait pt-6 md:border-l md:border-t-0 md:pl-8 md:pt-0">
        <li class="text-appui text-secondaire">
          Registre des écarts entre le pilote et une mise en production
        </li>
        <li class="text-appui text-secondaire">
          Ce qui doit être contrôlé par des règles, ce qui peut rester au modèle
        </li>
        <li class="text-appui text-secondaire">
          Un jeu de tests exécutable chez vous, sur vos dossiers
        </li>
        <li class="text-appui text-secondaire">Un plan séquencé P0 / P1 / P2</li>
      </ul>
    </div>
  </Section>

  <!-- ══ Conversion ══ -->
  <Section separee>
    <AppelAction />
  </Section>
</Base>
