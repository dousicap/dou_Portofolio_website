---
// Polices auto-hébergées, sous-ensemble latin uniquement : le site est en
// français et aucune requête ne part vers un tiers (cohérent avec le discours
// de souveraineté). Ajouter un sous-ensemble ici si /en voit le jour.
import '@fontsource-variable/inter/wght.css';
import { lien } from '../config/lien';
import '@fontsource-variable/inter-tight/wght.css';
import '../styles/tokens.css';

import Nav from '../components/Nav.astro';
import PiedDePage from '../components/PiedDePage.astro';
import { SITE } from '../config/site';

interface Props {
  titre: string;
  description: string;
  /** Pages internes (design system) : présentes au build, hors index. */
  noindex?: boolean;
}

const { titre, description, noindex = false } = Astro.props;

const titreComplet = titre === SITE.titre ? titre : `${titre} — ${SITE.nom}`;
const canonique = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang={SITE.langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" href={lien('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={lien('/sitemap-index.xml')} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-base focus:bg-accent focus:px-4 focus:py-2 focus:text-sur-accent"
    >
      Aller au contenu
    </a>

    <Nav />

    <main id="contenu" class="flex-1">
      <slot />
    </main>

    <PiedDePage />
  </body>
</html>
