---
/**
 * Maquette d'interface de Ledgera — écran de validation d'une écriture.
 *
 * HTML et tokens du site, pas une capture : le rendu reste net à toutes les
 * tailles. Toutes les données sont fictives, et la légende le dit.
 */
const pieces = [
  { ref: 'FAC-2026-0412', tiers: 'Imprimerie Lemoine', montant: '1 248,00', etat: 'controle', actif: true },
  { ref: 'FAC-2026-0411', tiers: 'Transports Delva', montant: '640,80', etat: 'pret' },
  { ref: 'REL-BQ-09-2026', tiers: 'Relevé bancaire', montant: '—', etat: 'pret' },
  { ref: 'FAC-2026-0409', tiers: 'Cabinet Morel', montant: '3 120,00', etat: 'comptabilise' },
  { ref: 'NDF-2026-0088', tiers: 'Note de frais', montant: '86,40', etat: 'comptabilise' },
];

const etats: Record<string, { libelle: string; classe: string }> = {
  controle: { libelle: 'Validation requise', classe: 'text-alerte border-alerte/40' },
  pret: { libelle: 'Proposée', classe: 'text-secondaire border-trait-controle' },
  comptabilise: { libelle: 'Comptabilisée', classe: 'text-accent border-accent/40' },
};

const lignes = [
  { compte: '606400', libelle: 'Fournitures administratives', debit: '1 040,00', credit: '' },
  { compte: '445660', libelle: 'TVA déductible sur ABS', debit: '208,00', credit: '' },
  { compte: '401LEM', libelle: 'Fournisseur Imprimerie Lemoine', debit: '', credit: '1 248,00' },
];

const controles = [
  { ok: true, texte: 'Écriture équilibrée débit / crédit' },
  { ok: true, texte: 'Taux de TVA cohérent avec la nature de la dépense' },
  { ok: true, texte: 'Pièce non comptabilisée en double' },
  { ok: false, texte: 'Fournisseur absent du référentiel : compte tiers à confirmer' },
];
---

<figure>
  <div class="overflow-hidden rounded-base border border-trait-controle bg-fond">
    <!-- Barre de fenêtre -->
    <div class="flex items-center gap-2 border-b border-trait bg-surface px-4 py-2.5">
      <span class="size-2.5 rounded-full bg-trait-controle"></span>
      <span class="size-2.5 rounded-full bg-trait-controle"></span>
      <span class="size-2.5 rounded-full bg-trait-controle"></span>
      <span class="ml-3 text-xs text-secondaire">Ledgera · Dossier client démo · Septembre 2026</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <!-- File des pièces -->
      <div class="border-b border-trait p-4 md:border-b-0 md:border-r">
        <div class="flex items-baseline justify-between">
          <p class="font-titre text-sm font-semibold">Pièces à traiter</p>
          <p class="text-xs text-secondaire">5 sur 142</p>
        </div>
        <ul class="mt-3 flex flex-col gap-1.5">
          {
            pieces.map((p) => (
              <li class={`rounded-base border px-3 py-2 ${p.actif ? 'border-trait-controle bg-surface' : 'border-transparent'}`}>
                <div class="flex items-center justify-between gap-2">
                  <span class="truncate text-xs font-medium">{p.tiers}</span>
                  <span class="shrink-0 text-xs tabular-nums text-secondaire">{p.montant}</span>
                </div>
                <div class="mt-1 flex items-center justify-between gap-2">
                  <span class="text-[11px] text-secondaire">{p.ref}</span>
                  <span class={`shrink-0 rounded-full border px-2 text-[10px] leading-5 ${etats[p.etat].classe}`}>
                    {etats[p.etat].libelle}
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Proposition et contrôles -->
      <div class="p-4">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-[11px] uppercase tracking-wider text-secondaire">Proposition d'écriture · journal ACH</p>
            <p class="mt-1 font-titre text-sm font-semibold">FAC-2026-0412 · Imprimerie Lemoine</p>
          </div>
          <div class="text-right">
            <p class="text-[11px] text-secondaire">Confiance du modèle</p>
            <p class="font-titre text-sm font-semibold tabular-nums">0,91</p>
          </div>
        </div>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[340px] text-xs">
            <thead>
              <tr class="border-b border-trait text-left text-[11px] text-secondaire">
                <th class="py-1.5 pr-2 font-normal">Compte</th>
                <th class="py-1.5 pr-2 font-normal">Libellé</th>
                <th class="py-1.5 pr-2 text-right font-normal">Débit</th>
                <th class="py-1.5 text-right font-normal">Crédit</th>
              </tr>
            </thead>
            <tbody>
              {
                lignes.map((l) => (
                  <tr class="border-b border-trait">
                    <td class="py-2 pr-2 tabular-nums">{l.compte}</td>
                    <td class="py-2 pr-2 text-secondaire">{l.libelle}</td>
                    <td class="py-2 pr-2 text-right tabular-nums whitespace-nowrap">{l.debit}</td>
                    <td class="py-2 text-right tabular-nums whitespace-nowrap">{l.credit}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="mt-5 text-[11px] uppercase tracking-wider text-secondaire">Contrôles déterministes</p>
        <ul class="mt-2 flex flex-col gap-1.5">
          {
            controles.map((c) => (
              <li class="flex items-start gap-2 text-xs">
                <span aria-hidden="true" class={`mt-0.5 inline-flex size-4 shrink-0 items-center justify-center rounded-full text-[10px] font-bold ${c.ok ? 'bg-accent/15 text-accent' : 'bg-alerte/15 text-alerte'}`}>
                  {c.ok ? '✓' : '!'}
                </span>
                <span class={c.ok ? 'text-secondaire' : 'text-texte'}>
                  <span class="sr-only">{c.ok ? 'Réussi : ' : 'Bloquant : '}</span>
                  {c.texte}
                </span>
              </li>
            ))
          }
        </ul>

        <div class="mt-5 rounded-base border border-alerte/40 bg-alerte/5 px-3 py-2.5 text-xs">
          <span class="font-medium text-alerte">Comptabilisation bloquée.</span>
          <span class="text-secondaire"> Un contrôle échoue : la confiance de 0,91 ne suffit pas. L'expert doit trancher.</span>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-base bg-accent px-3 py-1.5 text-xs font-medium text-sur-accent">Créer le tiers et valider</span>
          <span class="rounded-base border border-trait-controle px-3 py-1.5 text-xs">Renvoyer en remédiation</span>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="mt-3 text-menu text-secondaire">
    Maquette de l'écran de validation, données fictives. Le modèle est confiant,
    mais un contrôle bloquant échoue : l'écriture attend la décision de l'expert.
  </figcaption>
</figure>
