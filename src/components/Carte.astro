---
/**
 * Carte — conteneur de surface.
 *
 * Aucune ombre : la profondeur vient de la bordure 1px et du fond de surface.
 * Si `href` est fourni, toute la carte devient cliquable.
 */
interface Props {
  href?: string;
  class?: string;
}

const { href, class: classe = '' } = Astro.props;

const base = 'block rounded-base border border-trait bg-surface p-6 md:p-8';
const interactif = href
  ? 'transition-colors duration-150 hover:border-accent'
  : '';
const Balise = href ? 'a' : 'div';
---

<Balise href={href} class={`${base} ${interactif} ${classe}`}>
  <slot />
</Balise>
